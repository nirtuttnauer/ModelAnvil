# ModelAnvil Single-Server Reference Environment Variables

POSTGRES_DB=modelanvil
POSTGRES_USER=modelanvil
POSTGRES_PASSWORD=modelanvil_secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

RABBITMQ_USER=modelanvil
RABBITMQ_PASSWORD=modelanvil_secret
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY_ID=any
S3_SECRET_ACCESS_KEY=any
S3_BUCKET_NAME=modelanvil-artifacts
S3_REGION_NAME=us-east-1

SECRET_KEY=change-me-in-production-secure-random-token
DJANGO_SETTINGS_MODULE=modelanvil.settings
ALLOWED_HOSTS=localhost,127.0.0.1,api
