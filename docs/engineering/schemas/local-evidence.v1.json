{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modelanvil:schema:local-evidence:1",
  "title": "ModelAnvil local evidence record",
  "description": "One local command recorded with the full SHA, an empty git status, the machine, the exact command, full stdout and stderr, the exit code, and per-run collected, excluded-by-tag, and passed counts. The label is local. Skip, xfail, and timeout counts are zero. Hosted CI evidence is a separate record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "label",
    "sha",
    "git_status_porcelain",
    "recorded_at",
    "machine",
    "command",
    "exit_code",
    "stdout",
    "stderr",
    "runs"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "label": {"const": "local"},
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Full git SHA of the clean worktree the command ran against."
    },
    "git_status_porcelain": {
      "const": "",
      "description": "Exact stdout of git status --porcelain. Empty means a clean worktree."
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$",
      "description": "Date and time with a numeric zone offset."
    },
    "machine": {"$ref": "#/$defs/machine"},
    "command": {"type": "string", "minLength": 1},
    "exit_code": {"type": "integer"},
    "stdout": {"type": "string"},
    "stderr": {"type": "string"},
    "fixture_tests_not_collected": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "description": "Test IDs that require a verified local fixture and were not collected on this host. They are not runtime skips. A required run still has to execute them before the skip gate is closed."
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/run"}
    }
  },
  "$defs": {
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "os", "arch", "python", "node"],
      "properties": {
        "hostname": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "arch": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "node": {"type": "string", "minLength": 1}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "command",
        "collected",
        "excluded_by_tag",
        "passed",
        "skipped",
        "xfailed",
        "timeout",
        "excluded_ids"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "collected": {"type": "integer", "minimum": 0},
        "excluded_by_tag": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "skipped": {"const": 0},
        "xfailed": {"const": 0},
        "timeout": {"const": 0},
        "excluded_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
