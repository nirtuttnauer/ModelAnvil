{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modelanvil:schema:adapter-manifest:1.0",
  "title": "ModelAnvil adapter manifest",
  "description": "Capability declaration. Installation authorization and exact-combination qualification are separate server-side decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_id", "version", "platform_api", "image", "license", "capabilities", "resources", "permissions", "dependencies"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "adapter_id": {"type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"},
    "version": {"type": "string", "minLength": 1},
    "platform_api": {"type": "string", "minLength": 1},
    "image": {"type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$"},
    "license": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "input_schema_refs", "output_schema_refs"],
        "properties": {
          "kind": {"enum": ["acquire", "read", "validate", "transform", "view", "annotate", "predict", "train", "evaluate", "retrieve", "embed", "rerank", "serve", "project", "cluster", "export"]},
          "input_schema_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "output_schema_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "formats": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "architectures": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "recovery": {"enum": ["none", "restart", "verified_checkpoint"]},
          "configuration_schema_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu_cores", "memory_bytes", "gpu_count", "disk_bytes"],
      "properties": {
        "cpu_cores": {"type": "number", "exclusiveMinimum": 0},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "gpu_count": {"type": "integer", "minimum": 0},
        "gpu_memory_bytes": {"type": "integer", "minimum": 0},
        "disk_bytes": {"type": "integer", "minimum": 0},
        "distributed": {"type": "boolean", "default": false}
      }
    },
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["network_hosts", "artifact_access", "secret_kinds"],
      "properties": {
        "network_hosts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "artifact_access": {"type": "array", "uniqueItems": true, "items": {"enum": ["read_job_inputs", "write_attempt_staging"]}},
        "secret_kinds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "version", "digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "minLength": 1}
        }
      }
    },
    "fixture_manifest_ref": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
