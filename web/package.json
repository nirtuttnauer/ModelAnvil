{
  "name": "modelanvil-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run tokens:check && tsc -b && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "vitest run --config vitest.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "storybook": "storybook dev --host 127.0.0.1 -p 6006 --no-open --ci",
    "build-storybook": "storybook build",
    "tokens:sync": "node scripts/sync-figcraft-tokens.mjs",
    "tokens:check": "node scripts/sync-figcraft-tokens.mjs --check",
    "screenshots": "node scripts/screenshot-stories.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "4.1.12",
    "msw": "^3.0.3",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "1.64.1",
    "storybook": "10.6.5",
    "vitest": "4.1.12"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/static"
    ]
  }
}
