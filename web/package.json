    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "msw": "^3.0.3",
    "msw-storybook-addon": "^3.0.3",
    "storybook": "^10.6.1"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/static"
    ]
  }
